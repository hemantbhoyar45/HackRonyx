# Google Earth Engine configuration
# Set GEE_ENABLED=true to connect to real GEE; false runs demo mode.
GEE_ENABLED=false
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_FILE=

# Application URL configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL/PostGIS)
DATABASE_URL=postgresql://user:password@localhost/dbname

# Storage
REPORT_STORAGE_PATH=data/reports/pdf

# Tuning & Limits
MAX_ANALYSIS_RANGE_DAYS=365
CLOUD_THRESHOLD=30
WATER_MASK_METHOD=NDWI
WATER_MASK_THRESHOLD=0.0
ANOMALY_ROBUST_Z_THRESHOLD=2.5
ISOLATION_FOREST_ENABLED=false
ISOLATION_FOREST_MIN_SAMPLES=12
VALIDATION_MATCH_WINDOW_DAYS=3
SPATIAL_MATCH_TOLERANCE_METERS=1000

# Scene-level cloud filter (percentage, 0-100)
MAX_SCENE_CLOUD_PERCENT=30

# Minimum acceptable valid pixel percentage inside AOI after masking (0-100)
MIN_VALID_PIXEL_PERCENTAGE=50
