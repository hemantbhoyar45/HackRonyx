# Google Earth Engine configuration
# Set GEE_ENABLED=true to connect to real GEE; false runs demo mode.
GEE_ENABLED=false
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=

# Scene-level cloud filter (percentage, 0-100)
MAX_SCENE_CLOUD_PERCENT=30

# Minimum acceptable valid pixel percentage inside AOI after masking (0-100)
MIN_VALID_PIXEL_PERCENTAGE=50
